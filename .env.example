# Copy this file to .env and add your JarvisLabs Serverless API token.
# Never commit .env or paste credentials into source code.

# JarvisLabs API token: https://jarvislabs.ai/settings/api-keys
JARVIS_API_TOKEN=
# Alternative supported name: JARVISLABS_API_KEY=

# The endpoint and model are fixed in the app for this deployment.
# This model ID must match the JarvisLabs deployment.
JARVISLABS_MODEL=gemma-4-26b-a4b-it
JARVISLABS_TIMEOUT_SECONDS=120
JARVISLABS_MAX_OUTPUT_TOKENS=4096

# Optional image upload limit in MB (default: 10)
MAX_UPLOAD_MB=10

# Optional app metadata
APP_TITLE=Samjho
